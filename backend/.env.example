# Flask
FLASK_APP=run.py
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
PORT=5000
FLASK_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173

# M-Pesa Daraja (keep credentials server-side; use sandbox while testing)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-api-domain.example.com/payments/callback

# Resend password reset email
RESEND_API_KEY=
RESEND_FROM_EMAIL=SmartMove <noreply@your-verified-domain.com>
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRES_MINUTES=30

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/smartmove_db

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
